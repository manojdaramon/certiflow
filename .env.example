# CertiFlow Root Environment Variables

# Backend Service
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# Database (PostgreSQL)
POSTGRES_USER=certiflow
POSTGRES_PASSWORD=certiflow_secret
POSTGRES_DB=certiflow
DATABASE_URL=postgresql://certiflow:certiflow_secret@localhost:5432/certiflow?schema=public

# Redis & Queues
REDIS_HOST=localhost
REDIS_PORT=6379

# Client
VITE_API_BASE_URL=http://localhost:5000/api
CLIENT_PORT=3000

# Authentication
JWT_SECRET=certiflow-hackathon-insecure-dev-secret-key-32b
SESSION_EXPIRY=24h
