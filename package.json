{
  "name": "certiflow",
  "version": "1.0.0",
  "private": true,
  "description": "CertiFlow — Skilling Certificate Issuance Platform",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run --prefix server dev",
    "dev:client": "npm run --prefix client dev",
    "build": "npm run build:server && npm run build:client",
    "build:server": "npm run --prefix server build",
    "build:client": "npm run --prefix client build",
    "test": "npm run --prefix server test",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
