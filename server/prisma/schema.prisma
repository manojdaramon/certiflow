datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

enum Role {
    TRAINING_CENTRE
    DISTRICT_OFFICER
    QUALITY_TEAM
    STATE_OFFICE
}

model User {
    id        String   @id @default(uuid())
    name      String
    email     String   @unique
    role      Role
    district  String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("users")
}
